# HorizonAI 环境变量配置
# 复制此文件为 .env 并填入真实值（.env 已被 gitignore 忽略）

# MySQL 数据库
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# Redis 缓存（未安装 Redis 时可设置 REDIS_ENABLED=false）
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# 默认使用 RocketMQ；本地调试时可同时设为 local。
SPRING_PROFILES_ACTIVE=rocketmq
PIPELINE_DISPATCH_MODE=rocketmq
ROCKETMQ_NAME_SERVER=localhost:9876
PIPELINE_TOPIC=horizonai-pipeline-tasks
PIPELINE_CONSUMER_GROUP=horizonai-pipeline-consumer

# JWT 签名密钥
JWT_SECRET=replace_with_at_least_32_characters_secret

# 允许浏览器携带凭证访问 API 的来源；多个来源以英文逗号分隔
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your_key_here

# GitHub Personal Access Token（可选，用于拉取 GitHub 趋势）
GITHUB_API_TOKEN=your_github_token_here

# RSS 数据源，多个地址使用英文逗号分隔
RSS_FEED_URLS=

# 管理员初始密码（首次启动必填；不会写入日志）
HORIZONAI_ADMIN_PASSWORD=your_admin_password_here
